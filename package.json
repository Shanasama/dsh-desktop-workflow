{
  "name": "dsh-desktop-workflow",
  "version": "0.5.3",
  "private": true,
  "description": "Native /team command, one-time role and Jev settings, and bounded multi-agent workflow for DSH 0.2.0-rc.2",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./state": "./src/state.js"
  },
  "files": [
    "src",
    "lib",
    "docs",
    "scripts/profile-install.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "INSTALL-ME.md"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run build && npm run typecheck && npm test",
    "preview": "node scripts/preview.mjs",
    "test:profile": "node scripts/verify-profile.mjs",
    "test:host": "node --expose-internals scripts/verify-host.mjs",
    "test:team-host": "node --expose-internals scripts/verify-team-host.mjs",
    "test:v04-host": "node --test test/v04-host-acceptance.test.mjs",
    "test:client-host": "node --expose-internals scripts/verify-client-host.mjs",
    "test:verifier-host": "node --expose-internals scripts/verify-verifier-host.mjs",
    "test:verifier-windows": "node --expose-internals scripts/verify-verifier-windows.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "devDependencies": {
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  }
}
